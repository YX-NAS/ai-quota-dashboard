# 用户本地配置（含实时额度 API Key / Token，切勿提交）
config/plans.json
config/.zhipu-team-context.json
config/.port
# 历史归档库（SQLite，含 -wal/-shm 伴生文件）
config/*.sqlite*

# macOS
.DS_Store

# 日志与临时文件
*.log
tmp/

# 预编译的 macOS 应用（按 README 的 swiftc 命令自行编译）
menubar/AIQuota.app/
desktop/AIQuotaWidget.app/

# ZCode 客户端自动生成（工具工件，不入库）
.zcodeignore
